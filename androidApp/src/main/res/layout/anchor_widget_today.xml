<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/anchor_widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_widget_anchor"
            android:tint="@color/anchor_widget_primary"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/today_anchor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/anchor_widget_on_background"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="固定节律"
            xmlns:tools="http://schemas.android.com/tools" />
    </LinearLayout>

    <TextView
        android:id="@+id/today_micro_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/anchor_widget_on_background"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/today_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:textColor="@color/anchor_widget_primary"
        android:textSize="24sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/today_micro_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/anchor_widget_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/today_worry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/anchor_widget_muted"
        android:textSize="13sp" />
</LinearLayout>
