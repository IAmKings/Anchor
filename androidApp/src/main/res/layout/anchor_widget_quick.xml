<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/anchor_widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_widget_anchor"
            android:tint="@color/anchor_widget_primary"
            android:contentDescription="@null" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/anchor_widget_title"
            android:textColor="@color/anchor_widget_on_background"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_hang"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_widget_hang"
            android:tint="@color/anchor_widget_primary"
            android:contentDescription="@string/anchor_widget_hang" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/anchor_widget_hang"
            android:textColor="@color/anchor_widget_on_background"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_wave"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_widget_wave"
            android:tint="@color/anchor_widget_primary"
            android:contentDescription="@string/anchor_widget_wave" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/anchor_widget_wave"
            android:textColor="@color/anchor_widget_on_background"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_micro"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_widget_micro"
            android:tint="@color/anchor_widget_primary"
            android:contentDescription="@string/anchor_widget_micro" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/anchor_widget_micro"
            android:textColor="@color/anchor_widget_on_background"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
